APP_NAME=电商商品与客服工作台
DATABASE_URL=sqlite:///./data/dianshang.db

# MySQL 示例：mysql+pymysql://dianshang:dianshang@localhost:3306/dianshang?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://dianshang:dianshang@localhost:3306/dianshang?charset=utf8mb4

CRAWL_TIMEOUT_SECONDS=10
CRAWL_MAX_RETRIES=2
ARTIFACTS_DIR=artifacts

# S1 任务工程化（ThreadPoolExecutor + SQL claim）
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=0.5

# S2 文档导入
UPLOAD_MAX_BYTES=20971520
IMPORTS_DIR=uploads

# S3 RAG 检索（本地实现，生产请替换为 BGE-M3 / DashScope Embedding）
EMBEDDER_DIM=256
VECTOR_STORE_PATH=data/vectors.json
RAG_TOP_K=5
# S7 服务 API Key（机器/第三方系统凭证，不是员工网页登录账号）
API_AUTH_ENABLED=false
API_KEY=
API_TENANT_ID=default
API_USER_ID=api-user

# 员工登录与角色工作台；开启后页面需用户名/密码 session 登录
EMPLOYEE_AUTH_ENABLED=true
SESSION_COOKIE_NAME=dianshang_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
# 可选：后续由管理命令创建首个管理员，不建议在生产环境写明文密码
AUTH_BOOTSTRAP_LOGIN=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_DISPLAY_NAME=管理员
AUTH_BOOTSTRAP_TENANT_KEY=default
AUTH_BOOTSTRAP_WORKSPACE_NAME=默认商家
