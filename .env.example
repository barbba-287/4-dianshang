APP_NAME=电商商品与客服工作台
DATABASE_URL=sqlite:///./data/dianshang.db

# MySQL 示例：mysql+pymysql://dianshang:dianshang@localhost:3306/dianshang?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://dianshang:dianshang@localhost:3306/dianshang?charset=utf8mb4

CRAWL_TIMEOUT_SECONDS=10
CRAWL_MAX_RETRIES=2
ARTIFACTS_DIR=artifacts

# S1 任务工程化（ThreadPoolExecutor + SQL claim）
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=0.5

# S2 文档导入
UPLOAD_MAX_BYTES=20971520
IMPORTS_DIR=uploads

# S3 RAG 检索（本地实现，生产请替换为 BGE-M3 / DashScope Embedding）
EMBEDDER_DIM=256
VECTOR_STORE_PATH=data/vectors.json
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
